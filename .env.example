APP_NAME=Storelo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# If deployed behind a reverse proxy / CDN (Cloudflare, nginx, a load balancer),
# set this to its IP or CIDR range so $request->ip() resolves the real visitor
# IP instead of the proxy's — used by fraud detection, rate limiting, and audit
# logs. Leave empty for a direct (no-proxy) connection.
TRUSTED_PROXIES=

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopsystem_landlord
DB_USERNAME=root
DB_PASSWORD=

# MUST stay 'database' (or another tenant-aware driver) in production —
# 'file' resolves storage_path('framework/sessions') once at config-load
# time, before tenancy is identified, so every tenant's session files would
# land in one shared, non-isolated directory instead of each tenant's own
# storage/{tenant}/... root. 'database' is correctly isolated because its
# queries run on the 'tenant' connection, which tenancy middleware has
# already switched to by request time.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
FORCE_HTTPS=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_APP_SHORT_NAME="${APP_NAME}"
VITE_APP_DESCRIPTION="Multi-tenant e-commerce platform"
VITE_APP_THEME_COLOR="#3b82f6"
# VITE_HMR_HOST=192.168.1.100  # Uncomment when the dev server runs on another IP

# Reverb WebSocket server
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=example.com
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Tenant base domain (used when creating new shop subdomains)
TENANT_BASE_DOMAIN=example.com

# Cloudflare DNS auto-provisioning for new tenant subdomains (optional —
# CloudflareService::isConfigured() skips silently if any of these are
# empty). SERVER_IP is the A record's target and is easy to forget: without
# it, addSubdomain() sends a DNS record with no IP and Cloudflare rejects it.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SERVER_IP=

# Customer social login (SocialAuthController). Without these,
# Socialite::driver()->redirect() builds a redirect with an empty client_id
# — the customer silently lands on a Google/Facebook error page, no
# server-side exception at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Digital products — file storage
DIGITAL_DISK=local
DIGITAL_DOWNLOAD_PATH=downloads

# PHP-level upload limits (php.ini, NOT a Laravel/env setting — listed here
# only as a reminder). Laravel's own validation allows digital product
# files up to 100MB and CSV imports up to 10MB, both comfortably over a
# typical shared-hosting default (upload_max_filesize=2M, post_max_size=8M).
# Without raising both of these server-side, large uploads fail at the PHP
# layer before Laravel's validation ever runs, usually with a confusing
# generic error instead of a clear "file too large" message:
#   upload_max_filesize = 100M
#   post_max_size = 100M

# Shop defaults
DEFAULT_CURRENCY=PLN
DEFAULT_COUNTRY=PL
WEIGHT_UNIT=kg
DIMENSION_UNIT=cm
LOW_STOCK_THRESHOLD=5
STOCK_RESERVATION_MINUTES=15

# Super Admin (used by LandlordSeeder)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Deployment checklist (run after deploy):
# php artisan storage:link
# php artisan migrate --path=database/migrations/landlord --force
# php artisan tenants:migrate --force
# php artisan queue:work (supervisor recommended)
# Cron entry (REQUIRED — without it, none of the scheduled commands in
# routes/console.php ever run: backups, order/cart expiry, loyalty points,
# weekly reports, flash sale deactivation, pending-tenant cleanup...):
#   * * * * * cd /path-to-app && php artisan schedule:run >> /dev/null 2>&1
# composer install --no-dev --optimize-autoloader (never ship dev deps —
# filp/whoops in particular must not be present in production)
