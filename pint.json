{
 "preset": "laravel",
 "rules": {
  "declare_strict_types": false,
  "concat_space": {
   "spacing": "one"
  },
  "not_operator_with_successor_space": false,
  "phpdoc_align": {
   "align": "left"
  },
  "no_unused_imports": true,
  "ordered_imports": {
   "sort_algorithm": "alpha"
  }
 },
 "exclude": ["bootstrap/cache", "storage"]
}
